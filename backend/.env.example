# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://username:password@localhost:5432/project_management"

# At least 32 random characters used to sign JSON Web Tokens.
JWT_SECRET="replace-with-a-long-random-secret-of-at-least-32-characters"

# How long issued JSON Web Tokens remain valid.
JWT_EXPIRES_IN="7d"

# Comma-separated frontend origins permitted to call this API.
CORS_ORIGIN="http://localhost:5173,https://your-app.onrender.com"

# TCP port the server listens on; Render supplies this automatically.
PORT="3000"

# Runtime mode for local development or deployment.
NODE_ENV="development"
