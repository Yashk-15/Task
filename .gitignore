# ─── Root .gitignore ──────────────────────────────────────────────────────────
#
# Rules here apply to the ENTIRE monorepo (all modules: backend, web, mobile).
# Each module also has its own .gitignore for module-specific rules.
# Git merges all .gitignore files it finds — they never conflict, they combine.
#
# Anything already handled by a child .gitignore doesn't need repeating here,
# but cross-cutting concerns (OS files, IDE configs, secrets) belong here.
# ──────────────────────────────────────────────────────────────────────────────


# ─── Secrets & Environment Variables ─────────────────────────────────────────
# NEVER commit .env files — they contain API keys, database URLs, JWT secrets.
.env
.env.*
!.env.example         # .env.example (template with placeholder values) IS committed


# ─── Node / JavaScript (backend + web) ───────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
*.local               # Vite local config overrides (e.g. .env.local)

# npm / yarn / pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log


# ─── Flutter / Dart (mobile) ─────────────────────────────────────────────────
# The mobile/.gitignore handles most Flutter-specific ignores.
# We only add the cross-cutting ones here.
.dart_tool/
.pub-cache/
.pub/
mobile/build/         # Android/iOS build output (large, reproducible)
mobile/coverage/


# ─── Operating System files ───────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# ─── IDE / Editor ─────────────────────────────────────────────────────────────
# VS Code — commit extensions.json so teammates get recommended extensions,
# but ignore personal settings and launch configs.
.vscode/*
!.vscode/extensions.json

# JetBrains (IntelliJ, Android Studio, WebStorm, etc.)
.idea/
*.iml
*.ipr
*.iws

# Vim / Emacs swap files
*.swp
*.swo
*~


# ─── Prisma (backend) ────────────────────────────────────────────────────────
# Generated Prisma client — regenerated by `prisma generate`, not committed.
backend/src/generated/
backend/generated/
backend/prisma/generated/


# ─── Misc ────────────────────────────────────────────────────────────────────
*.class
*.pyc
.cache/
.temp/
.tmp/
